# Copy to secrets.yaml in your ESPHome config folder and fill in your own values.
# Never commit secrets.yaml.
#
# api_encryption_key: 32 random bytes, base64. ESPHome's "New device" wizard
# generates one, or run:  openssl rand -base64 32

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
api_encryption_key: "REPLACE_WITH_YOUR_OWN_BASE64_KEY"
ota_password: "choose-an-ota-password"
fallback_ap_password: "choose-a-fallback-password"
